generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// KİMLİK DOĞRULAMA (NextAuth.js v5 + Prisma Adapter)
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  supportTickets SupportTicket[]
  b2bContact    B2BCompany?    @relation("B2BUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// MÜŞTERİ ADRESLERİ
// ─────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String  // "Ev", "İş"
  fullName   String
  phone      String
  city       String
  district   String
  postalCode String?
  address    String  @db.Text
  isDefault  Boolean @default(false)
  orders     Order[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// ÜRÜN KATALOĞu & VARYANTLAR
// ─────────────────────────────────────────────

enum ProductCategory {
  ORTHOPEDIC_INSOLE
  BELT
  SHOE_CARE
  LUGGAGE_PARTS
  OTHER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String          @db.Text
  shortDesc       String?
  price           Float
  compareAtPrice  Float?          // Üstü çizili eski fiyat
  costPrice       Float?          // Maliyet (müşteri görmez)
  category        ProductCategory @default(OTHER)
  status          ProductStatus   @default(ACTIVE)
  sku             String?         @unique
  barcode         String?
  vendor          String?         @default("Davut Kundura Atölyesi")
  tags            String[]
  imageUrls       String[]        @db.Text
  stock           Int             @default(0)
  lowStockAlert   Int             @default(5) // Bu sayının altına düşünce uyarı ver
  weight          Float?          // gram
  trackInventory  Boolean         @default(true)
  allowBackorder  Boolean         @default(false)

  variants        ProductVariant[]
  orderItems      OrderItem[]
  inventory       InventoryTransaction[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  productionOrders ProductionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String  // Örn: "42 Numara - Siyah"
  size       String?
  color      String?
  price      Float?  // Null ise ürünün ana fiyatını kullan
  stock      Int     @default(0)
  sku        String?
  imageUrl   String?

  orderItems OrderItem[]
  warehouseStocks WarehouseStock[]
}

// ─────────────────────────────────────────────
// SİPARİŞ & SATIŞ YÖNETİMİ
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING      // Bekliyor
  PROCESSING   // Hazırlanıyor
  SHIPPED      // Kargoya verildi
  DELIVERED    // Teslim edildi
  CANCELLED    // İptal edildi
  REFUNDED     // İade edildi
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // ORD-2024-0001 formatı
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?      @relation(fields: [addressId], references: [id])
  
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  
  subtotal        Float
  shippingCost    Float         @default(0)
  discountAmount  Float         @default(0)
  totalAmount     Float
  
  // Paytr Altyapısı
  paytrMerchantOid String?      // Paytr sipariş numarası
  paytrToken       String?      // Paytr token
  
  // Kargo Altyapısı  
  cargoCompany    String?       // "Yurtiçi", "Aras", "MNG", "PTT"
  cargoTrackingNo String?       // Kargo takip numarası
  cargoSentAt     DateTime?
  
  discountCodeId  String?
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id])
  
  notes           String?       @db.Text // Müşteri notu
  adminNotes      String?       @db.Text // Admin notu (müşteri görmez)
  
  items           OrderItem[]
  invoice         Invoice?
  supportTickets  SupportTicket[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float           // Satış anındaki fiyat (sonradan değişmesin)
  costPrice Float?          // Satış anındaki maliyet
}

// ─────────────────────────────────────────────
// STOK & ENVANTER YÖNETİMİ
// ─────────────────────────────────────────────

enum InventoryType {
  IN       // Stok girişi (tedarik, iade)
  OUT      // Stok çıkışı (satış, hasar)
  ADJUST   // Manuel düzeltme
}

model InventoryTransaction {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int           // Pozitif: Giriş, Negatif: Çıkış
  type      InventoryType
  notes     String?
  createdBy String?       // Admin kullanıcı adı

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// MUHASEBE & FİNANS
// ─────────────────────────────────────────────

enum ExpenseCategory {
  SHIPPING    // Kargo gideri
  SUPPLIES    // Hammadde/malzeme
  RENT        // Kira
  SALARY      // Personel
  MARKETING   // Reklam
  OTHER       // Diğer
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  description String?
  date        DateTime        @default(now())
  receiptUrl  String?         // Fiş/fatura görseli

  createdAt DateTime @default(now())
}

model FinancialRecord {
  id           String   @id @default(cuid())
  month        Int
  year         Int
  revenue      Float    @default(0)
  expense      Float    @default(0)
  profit       Float    @default(0)
  taxEstimate  Float    @default(0)
  orderCount   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

// ─────────────────────────────────────────────
// FATURA SİSTEMİ (ALTYAPI)
// ─────────────────────────────────────────────

model Invoice {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  invoiceNo   String   @unique // FAT-2024-0001
  pdfUrl      String?           // Oluşturulan PDF linki
  issuedAt    DateTime @default(now())
}

// ─────────────────────────────────────────────
// KARGO ENTEGRASYONU (ALTYAPI HAZIR)
// ─────────────────────────────────────────────

enum CargoStatus {
  PREPARING    // Hazırlanıyor
  AT_CARGO     // Kargoda
  ON_THE_WAY   // Yolda
  DELIVERED    // Teslim edildi
  RETURNED     // İade oldu
}

model CargoTracking {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  company       String      // "Yurtiçi", "Aras", "MNG"
  trackingNo    String
  status        CargoStatus @default(PREPARING)
  estimatedDate DateTime?
  deliveredAt   DateTime?
  events        Json?       // Kargo olayları (konum güncellemeleri)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// İNDİRİM KOD SİSTEMİ
// ─────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE  // %10 indirim
  FIXED       // 50₺ indirim
  FREE_SHIP   // Ücretsiz kargo
}

model DiscountCode {
  id              String       @id @default(cuid())
  code            String       @unique
  type            DiscountType
  value           Float        // 10 (yüzde için) veya 50 (sabit için)
  minOrderAmount  Float?       // Minimum sipariş tutarı
  maxUses         Int?         // Maksimum kullanım sayısı
  usedCount       Int          @default(0)
  isActive        Boolean      @default(true)
  expiresAt       DateTime?
  orders          Order[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// ÜRÜN YORUMLARI & FAVORİLER
// ─────────────────────────────────────────────

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  rating    Int     // 1-5
  title     String?
  body      String? @db.Text
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────
// CANLI ANALİTİK & ZİYARETÇİ TAKİBİ
// ─────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // "pageview", "add_to_cart", "purchase", "product_view"
  sessionId   String   // Ziyaretçi oturumu
  userId      String?  // Giriş yapmışsa
  page        String?  // Hangi sayfa
  productId   String?  // Ürünle ilgiliyse
  country     String?  // TR, US, DE
  city        String?  
  lat         Float?   // Enlem (globe için)
  lng         Float?   // Boylam (globe için)
  device      String?  // "mobile", "desktop", "tablet"
  browser     String?
  referrer    String?
  metadata    Json?

  createdAt DateTime @default(now())
}

model ActiveSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  country   String?
  city      String?
  lat       Float?
  lng       Float?
  page      String?
  device    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// BİLDİRİM SİSTEMİ
// ─────────────────────────────────────────────

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  NEW_REVIEW
  PAYMENT_RECEIVED
  CARGO_DELIVERED
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// VİTRİN İÇERİK YÖNETİMİ (CMS)
// ─────────────────────────────────────────────

model SiteSettings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String   @db.Text
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PRO VİTRİN & MAĞAZA TASARIMCISI (ADVANCED CMS)
// ─────────────────────────────────────────────

enum PageType {
  HOME
  CUSTOM
  PRODUCT_TEMPLATE
  CATEGORY_TEMPLATE
  POLICY
}

model StoreTheme {
  id          String   @id @default(cuid())
  name        String   @default("Davut Kundura PRO Theme")
  isActive    Boolean  @default(false)
  colors      Json     // Primary, secondary, background, text colors
  typography  Json     // H1, H2, body font family, size, weight
  settings    Json     // Global settings (border radius, animations global state)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StorePage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  type        PageType @default(CUSTOM)
  isPublished Boolean  @default(false)
  seoTitle    String?
  seoDesc     String?
  blocks      StoreBlock[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoreBlock {
  id          String    @id @default(cuid())
  pageId      String?
  page        StorePage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        String    // "Hero", "ProductGrid", "Slider", "RichText", "VideoBg", etc.
  order       Int       @default(0) // Sayfa içindeki sırası
  content     Json      // { title, subtitle, buttonText, imageUrl, etc }
  style       Json      // { padding, margin, backgroundColor, animations, CSS filters }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StoreTemplate {
  id          String   @id @default(cuid())
  name        String   // e.g., "Luxury Dark Hero", "Modern Product Grid"
  category    String   // "Hero", "Features", "Testimonials", "Footers"
  previewUrl  String?  // Thumbnail image of the template
  structure   Json     // JSON tree representing the UI blocks
  createdAt   DateTime @default(now())
}

model NavigationMenu {
  id          String   @id @default(cuid())
  name        String   @unique // "Header", "Footer", "Sidebar"
  items       NavigationItem[]
  createdAt   DateTime @default(now())
}

model NavigationItem {
  id          String   @id @default(cuid())
  menuId      String
  menu        NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label       String
  url         String
  order       Int      @default(0)
  parentId    String?  // For dropdowns / mega menus
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// ENTERPRISE (HOLDİNG SEVİYESİ) ERP & YÖNETİM MODÜLLERİ
// ─────────────────────────────────────────────

// 1. Çoklu Depo ve Atölye Yönetimi (Multi-Warehouse)
model Warehouse {
  id          String   @id @default(cuid())
  name        String   // "Merkez Depo", "İstanbul Şube", "Üretim Atölyesi"
  code        String   @unique // "WH-001"
  address     String?  @db.Text
  managerName String?
  isActive    Boolean  @default(true)
  stockItems  WarehouseStock[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  reserved    Int      @default(0) // Sipariş verilmiş ama henüz kargolanmamış stok
  shelfLoc    String?  // Depodaki raf konumu (Örn: A-12-B)
  
  @@unique([warehouseId, variantId])
}

// 2. Tedarikçi ve Hammadde Yönetimi (Supply Chain)
model Supplier {
  id          String   @id @default(cuid())
  name        String   // "Hakiki Deri A.Ş.", "Taban Plastik Sanayi"
  contactName String?
  email       String?
  phone       String?
  taxNumber   String?
  address     String?  @db.Text
  materials   RawMaterial[]
  createdAt   DateTime @default(now())
}

model RawMaterial {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  name        String   // "Birinci Sınıf Dana Derisi (Siyah)"
  sku         String   @unique
  unit        String   // "m2", "Adet", "Kg"
  stockQty    Float    @default(0)
  costPerUnit Float
  createdAt   DateTime @default(now())
}

// 3. Üretim / Atölye Takip Sistemi (Manufacturing)
enum ProductionStatus {
  PLANNING
  CUTTING
  SEWING
  ASSEMBLY
  QUALITY_CHECK
  COMPLETED
}

model ProductionOrder {
  id          String   @id @default(cuid())
  orderNo     String   @unique // PRD-2024-001
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  targetDate  DateTime?
  status      ProductionStatus @default(PLANNING)
  costEst     Float?   // Tahmini maliyet
  actualCost  Float?   // Gerçekleşen maliyet
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. B2B / Toptan Satış Yönetimi
model B2BCompany {
  id            String   @id @default(cuid())
  companyName   String
  taxOffice     String?
  taxNumber     String?
  discountTier  Float    @default(10.0) // %10 toptancı indirimi
  creditLimit   Float?   // Açık hesap limiti
  balanceOwed   Float    @default(0)    // Firmadan alacak
  // Note: Added user relation using existing User model (needs relation field on User model if required, omitted for now)
  createdAt     DateTime @default(now())
}

// 5. Gelişmiş Müşteri Hizmetleri (Ticketing & RMA)
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNo    String   @unique // TKT-9012
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  subject     String
  message     String   @db.Text
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?  // Admin User ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 6. Denetim İzleri (Audit Logs) - Kim ne zaman ne yaptı? (Güvenlik)
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String   // İşlemi yapan yönetici
  action      String   // "UPDATE_PRODUCT", "DELETE_ORDER", "CHANGE_PRICE"
  entityType  String   // "Product", "Order", "User"
  entityId    String   // Etkilenen verinin ID'si
  oldData     Json?    // Değişiklik öncesi veri (Geri alma için)
  newData     Json?    // Değişiklik sonrası veri
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}
