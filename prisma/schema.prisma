generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// KİMLİK DOĞRULAMA (NextAuth.js v5 + Prisma Adapter)
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  supportTickets SupportTicket[]
  b2bContact    B2BCompany?    @relation("B2BUser")
  personalDiscounts DiscountCode[] @relation("PersonalDiscount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// MÜŞTERİ ADRESLERİ
// ─────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String  // "Ev", "İş"
  fullName   String
  phone      String
  city       String
  district   String
  postalCode String?
  address    String  @db.Text
  isDefault  Boolean @default(false)
  orders     Order[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// ─────────────────────────────────────────────
// PIM: ÜRÜN BİLGİ YÖNETİMİ (Enterprise Grade)
// ─────────────────────────────────────────────

enum ProductCategory {
  ORTHOPEDIC_INSOLE
  BELT
  SHOE_CARE
  LUGGAGE_PARTS
  OTHER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// Ürünün hangi satış kanallarında görüneceğini belirler.
// Bu sayede depo ürünü web'de gizlenirken B2B portalında gösterilebilir.
model ChannelVisibility {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  showOnWeb   Boolean  @default(true)   // Müşteri vitrini
  showOnB2B   Boolean  @default(false)  // Bayi / Toptan portalı
  showOnPOS   Boolean  @default(false)  // Fiziksel mağaza kasası

  // Zamanlanmış yayın: Null ise anında aktif
  publishAt   DateTime?
  unpublishAt DateTime?

  updatedAt   DateTime @updatedAt
}

// Ana Ürün (Master Product = Fiziksel Gerçeklik)
model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String          @db.Text
  shortDesc       String?

  // ── Fiyatlandırma ──
  price           Float
  compareAtPrice  Float?          // Üstü çizili eski fiyat
  costPrice       Float?          // Maliyet (müşteri görmez)

  // ── Sınıflandırma ──
  category        ProductCategory @default(OTHER)
  status          ProductStatus   @default(ACTIVE)
  vendor          String?         @default("Davut Kundura Atölyesi")
  tags            String[]

  // ── Medya ──
  imageUrls       String[]        @db.Text
  videoUrl        String?         // Ürün tanıtım videosu
  modelUrl3D      String?         // AR için .glb / .usdz dosyası

  // ── Stok & Lojistik ──
  sku             String?         @unique
  barcode         String?
  weight          Float?          // gram
  lowStockAlert   Int             @default(5)
  trackInventory  Boolean         @default(true)
  allowBackorder  Boolean         @default(false)

  // ── SEO ──
  seoTitle        String?
  seoDesc         String?
  seoKeywords     String[]

  // ── İlişkiler ──
  channelVisibility ChannelVisibility?
  variants          ProductVariant[]
  options           ProductOption[]     // "Renk", "Numara" gibi seçenek grupları
  orderItems        OrderItem[]
  inventory         InventoryTransaction[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  productionOrders  ProductionOrder[]
  bundleItems       ProductBundleItem[] @relation("BundleComponents") // Bu ürün bir paketin parçası

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sanal Paket (Bundle): Birden fazla ürünü tek paket olarak satar,
// satıldığında her bileşenin stoğunu otomatik düşer.
model ProductBundle {
  id          String              @id @default(cuid())
  name        String              // "Profesyonel Bakım Seti"
  description String?             @db.Text
  price       Float               // Paketin toplam satış fiyatı
  imageUrl    String?
  isActive    Boolean             @default(true)
  items       ProductBundleItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProductBundleItem {
  id         String         @id @default(cuid())
  bundleId   String
  bundle     ProductBundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation("BundleComponents", fields: [productId], references: [id])
  variantId  String?        // Belirli bir varyant kilitlenebilir (örn: sadece Siyah)
  quantity   Int            @default(1) // Pakette kaç adet var?

  @@unique([bundleId, productId, variantId])
}

// Ürün seçenek grubu (Örn: "Renk", "Numara", "Materyal")
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String               // "Renk", "Numara"
  position  Int                  @default(0) // Gösterim sırası
  values    ProductOptionValue[]
}

// Her seçeneğin alabileceği değerler
model ProductOptionValue {
  id               String        @id @default(cuid())
  optionId         String
  option           ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value            String        // "Siyah", "42", "Süet"
  // Koşullu görünürlük: Sadece belirli bir üst değer seçilince görünür
  // Örn: Sadece "Siyah" renk seçilince "Süet" materyali aç
  dependsOnValueId String?
  position         Int           @default(0)
}

// Ürün Varyantı (Her kombinasyon = 1 varyant, kendi SKU ve stokuyla)
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // ── Tanımlama ──
  name       String   // "42 Numara - Siyah - Hakiki Deri"
  size       String?
  color      String?
  material   String?  // Yeni: Materyal varyasyonu

  // ── Fiyat & Maliyet ──
  price      Float?   // Null ise ürünün ana fiyatını kullan
  costPrice  Float?   // Varyanta özel maliyet

  // ── Stok & Kimlik ──
  sku        String?  @unique
  barcode    String?  // Her varyantın kendi barkodu
  stock      Int      @default(0)
  imageUrl   String?
  isActive   Boolean  @default(true)

  // ── İlişkiler ──
  orderItems      OrderItem[]
  warehouseStocks WarehouseStock[]
  stockLedger     StockLedger[]
}

// ─────────────────────────────────────────────
// SİPARİŞ & SATIŞ YÖNETİMİ
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING      // Bekliyor
  PROCESSING   // Hazırlanıyor
  SHIPPED      // Kargoya verildi
  DELIVERED    // Teslim edildi
  CANCELLED    // İptal edildi
  REFUNDED     // İade edildi
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // ORD-2024-0001 formatı
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?      @relation(fields: [addressId], references: [id])
  
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  
  subtotal        Float
  shippingCost    Float         @default(0)
  discountAmount  Float         @default(0)
  totalAmount     Float
  
  // Paytr Altyapısı
  paytrMerchantOid String?      // Paytr sipariş numarası
  paytrToken       String?      // Paytr token
  
  // Kargo Altyapısı  
  cargoCompany    String?       // "Yurtiçi", "Aras", "MNG", "PTT"
  cargoTrackingNo String?       // Kargo takip numarası
  cargoSentAt     DateTime?
  
  discountCodeId  String?
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id])
  
  notes           String?       @db.Text // Müşteri notu
  adminNotes      String?       @db.Text // Admin notu (müşteri görmez)
  
  items           OrderItem[]
  invoice         Invoice?
  supportTickets  SupportTicket[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Float           // Satış anındaki fiyat (sonradan değişmesin)
  costPrice Float?          // Satış anındaki maliyet
}

// ─────────────────────────────────────────────
// STOK & ENVANTER YÖNETİMİ
// ─────────────────────────────────────────────

enum StockMovementType {
  PURCHASE     // Tedarikçiden satın alma girişi
  SALE         // Sipariş satış çıkışı
  RETURN_IN    // Müşteri iadesi girişi
  RETURN_OUT   // Tedarikçiye iade çıkışı
  TRANSFER_IN  // Depodan transfer girişi
  TRANSFER_OUT // Depoya transfer çıkışı
  ADJUSTMENT   // Manuel sayım düzeltmesi
  RESERVED     // Sipariş için rezerve
  UNRESERVED   // Rezerve iptali
}

// ERP-grade stok defteri: Stok miktarı doğrudan güncellenmez,
// her hareket buraya yazılır. Gerçek stok = SUM(quantity) per variant+warehouse
model StockLedger {
  id            String            @id @default(cuid())
  variantId     String
  variant       ProductVariant    @relation(fields: [variantId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  movementType  StockMovementType
  quantity      Int               // Pozitif: giriş, Negatif: çıkış
  unitCost      Float?            // Hareket anındaki birim maliyet (FIFO için)
  reference     String?           // Sipariş no, tedarik no, vb.
  notes         String?
  performedBy   String?           // Admin user ID veya "system"
  createdAt     DateTime          @default(now())

  @@index([variantId, warehouseId])
  @@index([createdAt])
}

// Geriye dönük uyumluluk için tutuldu
model InventoryTransaction {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  quantity  Int
  type      StockMovementType
  notes     String?
  createdBy String?

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// MUHASEBE & FİNANS
// ─────────────────────────────────────────────

enum ExpenseCategory {
  SHIPPING    // Kargo gideri
  SUPPLIES    // Hammadde/malzeme
  RENT        // Kira
  SALARY      // Personel
  MARKETING   // Reklam
  OTHER       // Diğer
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  description String?
  date        DateTime        @default(now())
  receiptUrl  String?         // Fiş/fatura görseli

  createdAt DateTime @default(now())
}

model FinancialRecord {
  id           String   @id @default(cuid())
  month        Int
  year         Int
  revenue      Float    @default(0)
  expense      Float    @default(0)
  profit       Float    @default(0)
  taxEstimate  Float    @default(0)
  orderCount   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
}

// ─────────────────────────────────────────────
// FATURA SİSTEMİ (ALTYAPI)
// ─────────────────────────────────────────────

model Invoice {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  invoiceNo   String   @unique // FAT-2024-0001
  pdfUrl      String?           // Oluşturulan PDF linki
  issuedAt    DateTime @default(now())
}

// ─────────────────────────────────────────────
// KARGO ENTEGRASYONU (ALTYAPI HAZIR)
// ─────────────────────────────────────────────

enum CargoStatus {
  PREPARING    // Hazırlanıyor
  AT_CARGO     // Kargoda
  ON_THE_WAY   // Yolda
  DELIVERED    // Teslim edildi
  RETURNED     // İade oldu
}

model CargoTracking {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  company       String      // "Yurtiçi", "Aras", "MNG"
  trackingNo    String
  status        CargoStatus @default(PREPARING)
  estimatedDate DateTime?
  deliveredAt   DateTime?
  events        Json?       // Kargo olayları (konum güncellemeleri)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// İNDİRİM KOD SİSTEMİ
// ─────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE  // %10 indirim
  FIXED       // 50₺ indirim
  FREE_SHIP   // Ücretsiz kargo
}

model DiscountCode {
  id                    String       @id @default(cuid())
  code                  String       @unique
  description           String?      // Admin notları
  type                  DiscountType
  value                 Float        // 10 (%10) veya 50 (50₺)
  maxDiscount           Float?       // Yüzdelik indirimlerde tavan (Örn: max 200₺)

  // ── Koşullar ──
  minOrderAmount        Float?       // Minimum sepet tutarı
  applicableCategories  String[]     // Geçerli kategori kodları (boş = tümü)
  applicableProductIds  String[]     // Geçerli ürün ID'leri (boş = tümü)

  // ── Limitler ──
  maxUses               Int?         // Toplam kullanım limiti
  perUserLimit          Int          @default(1)  // Kullanıcı başına limit
  usedCount             Int          @default(0)  // Toplam kullanılma sayısı

  // ── Zaman ──
  startsAt              DateTime     @default(now())
  expiresAt             DateTime?

  // ── Durum & Raporlama ──
  isActive              Boolean      @default(true)
  totalDiscountGiven    Float        @default(0)  // Toplam indirim maliyeti (₺)

  // ── İlişkiler ──
  userId                String?      // Kişiye özel (VIP)
  user                  User?        @relation("PersonalDiscount", fields: [userId], references: [id])
  orders                Order[]
  usageLogs             CouponUsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Kullanıcı başına kupon kullanım kaydı
model CouponUsageLog {
  id             String       @id @default(cuid())
  discountCodeId String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId         String
  orderId        String?      // Hangi siparişte kullanıldı
  discountAmount Float        // Bu kullanımda uygulanan indirim tutarı
  createdAt      DateTime     @default(now())

  @@index([discountCodeId, userId])
}


// ─────────────────────────────────────────────
// ÜRÜN YORUMLARI & FAVORİLER
// ─────────────────────────────────────────────

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  rating    Int     // 1-5
  title     String?
  body      String? @db.Text
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────
// CANLI ANALİTİK & ZİYARETÇİ TAKİBİ
// ─────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // "pageview", "add_to_cart", "purchase", "product_view"
  sessionId   String   // Ziyaretçi oturumu
  userId      String?  // Giriş yapmışsa
  page        String?  // Hangi sayfa
  productId   String?  // Ürünle ilgiliyse
  country     String?  // TR, US, DE
  city        String?  
  lat         Float?   // Enlem (globe için)
  lng         Float?   // Boylam (globe için)
  device      String?  // "mobile", "desktop", "tablet"
  browser     String?
  referrer    String?
  metadata    Json?

  createdAt DateTime @default(now())
}

model ActiveSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  country   String?
  city      String?
  lat       Float?
  lng       Float?
  page      String?
  device    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// BİLDİRİM SİSTEMİ
// ─────────────────────────────────────────────

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  NEW_REVIEW
  PAYMENT_RECEIVED
  CARGO_DELIVERED
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// VİTRİN İÇERİK YÖNETİMİ (CMS)
// ─────────────────────────────────────────────

model SiteSettings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String   @db.Text
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PRO VİTRİN & MAĞAZA TASARIMCISI (ADVANCED CMS)
// ─────────────────────────────────────────────

enum PageType {
  HOME
  CUSTOM
  PRODUCT_TEMPLATE
  CATEGORY_TEMPLATE
  POLICY
}

model StoreTheme {
  id          String   @id @default(cuid())
  name        String   @default("Davut Kundura PRO Theme")
  isActive    Boolean  @default(false)
  colors      Json     // Primary, secondary, background, text colors
  typography  Json     // H1, H2, body font family, size, weight
  settings    Json     // Global settings (border radius, animations global state)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StorePage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  type        PageType @default(CUSTOM)
  isPublished Boolean  @default(false)
  seoTitle    String?
  seoDesc     String?
  blocks      StoreBlock[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StoreBlock {
  id          String    @id @default(cuid())
  pageId      String?
  page        StorePage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        String    // "Hero", "ProductGrid", "Slider", "RichText", "VideoBg", etc.
  order       Int       @default(0) // Sayfa içindeki sırası
  content     Json      // { title, subtitle, buttonText, imageUrl, etc }
  style       Json      // { padding, margin, backgroundColor, animations, CSS filters }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StoreTemplate {
  id          String   @id @default(cuid())
  name        String   // e.g., "Luxury Dark Hero", "Modern Product Grid"
  category    String   // "Hero", "Features", "Testimonials", "Footers"
  previewUrl  String?  // Thumbnail image of the template
  structure   Json     // JSON tree representing the UI blocks
  createdAt   DateTime @default(now())
}

model NavigationMenu {
  id          String   @id @default(cuid())
  name        String   @unique // "Header", "Footer", "Sidebar"
  items       NavigationItem[]
  createdAt   DateTime @default(now())
}

model NavigationItem {
  id          String   @id @default(cuid())
  menuId      String
  menu        NavigationMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label       String
  url         String
  order       Int      @default(0)
  parentId    String?  // For dropdowns / mega menus
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────
// ENTERPRISE (HOLDİNG SEVİYESİ) ERP & YÖNETİM MODÜLLERİ
// ─────────────────────────────────────────────

// 1. Çoklu Depo ve Atölye Yönetimi (Multi-Warehouse)
model Warehouse {
  id          String   @id @default(cuid())
  name        String   // "Merkez Depo", "İstanbul Şube", "Üretim Atölyesi"
  code        String   @unique // "WH-001"
  address     String?  @db.Text
  managerName String?
  isActive    Boolean        @default(true)
  stockItems  WarehouseStock[]
  stockLedger StockLedger[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model WarehouseStock {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int            @default(0)  // Cache: StockLedger toplamından senkronize edilir
  reserved    Int            @default(0)  // Sepet/sipariş rezervi
  minStock    Int            @default(5)  // Bu depodaki kritik seviye
  shelfLoc    String?                     // Raf konumu (Örn: A-12-B)

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

// 2. Tedarikçi ve Hammadde Yönetimi (Supply Chain)
model Supplier {
  id          String   @id @default(cuid())
  name        String   // "Hakiki Deri A.Ş.", "Taban Plastik Sanayi"
  contactName String?
  email       String?
  phone       String?
  taxNumber   String?
  address     String?  @db.Text
  materials   RawMaterial[]
  createdAt   DateTime @default(now())
}

model RawMaterial {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  name        String   // "Birinci Sınıf Dana Derisi (Siyah)"
  sku         String   @unique
  unit        String   // "m2", "Adet", "Kg"
  stockQty    Float    @default(0)
  costPerUnit Float
  createdAt   DateTime @default(now())
}

// 3. Üretim / Atölye Takip Sistemi (Manufacturing)
enum ProductionStatus {
  PLANNING
  CUTTING
  SEWING
  ASSEMBLY
  QUALITY_CHECK
  COMPLETED
}

model ProductionOrder {
  id          String   @id @default(cuid())
  orderNo     String   @unique // PRD-2024-001
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  targetDate  DateTime?
  status      ProductionStatus @default(PLANNING)
  costEst     Float?   // Tahmini maliyet
  actualCost  Float?   // Gerçekleşen maliyet
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. B2B / Toptan Satış Yönetimi
model B2BCompany {
  id            String   @id @default(cuid())
  companyName   String
  taxOffice     String?
  taxNumber     String?
  discountTier  Float    @default(10.0) // %10 toptancı indirimi
  creditLimit   Float?   // Açık hesap limiti
  balanceOwed   Float    @default(0)    // Firmadan alacak
  
  contactUserId String?  @unique
  contactUser   User?    @relation("B2BUser", fields: [contactUserId], references: [id])
  
  createdAt     DateTime @default(now())
}

// 5. Gelişmiş Müşteri Hizmetleri (Ticketing & RMA)
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNo    String   @unique // TKT-9012
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  subject     String
  message     String   @db.Text
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?  // Admin User ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 6. Denetim İzleri (Audit Logs) - Kim ne zaman ne yaptı? (Güvenlik)
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String   // İşlemi yapan yönetici
  action      String   // "UPDATE_PRODUCT", "DELETE_ORDER", "CHANGE_PRICE"
  entityType  String   // "Product", "Order", "User"
  entityId    String   // Etkilenen verinin ID'si
  oldData     Json?    // Değişiklik öncesi veri (Geri alma için)
  newData     Json?    // Değişiklik sonrası veri
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}
